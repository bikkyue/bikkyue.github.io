---
interface Props {
  desc: string;
  link: string;
  icon: string;
}
const { desc, link, icon } = Astro.props;
const isImage = icon.endsWith(".png") || icon.endsWith(".jpg") || icon.endsWith(".jpeg") || icon.endsWith(".svg");

---

<a
  href={`https://${link}`}
  target='_blank'
  class='bg-black/10 p-4 rounded-2xl border-white/10 border active:scale-95 duration-200 ease-in-out hover:brightness-200'
>
<div class='flex gap-4 justify-between items-center'>
  <!-- アイコンが画像かクラス名かを判断して動的に表示 -->
  {isImage ? (
    <img src={icon} alt={desc} class="w-8 h-8 object-contain" />
  ) : (
    <i class={`${icon} text-xl`}></i>
  )}
  <h1 class='font-extrabold text-2xl'>{desc}</h1>
</div>
</a>
