---
// props を使って画像のパスをカスタマイズ可能にします
const { src = "/icon/Profile.png", alt = "Profile Icon" } = Astro.props;
---

<div class="icon">
  <img src={src} alt={alt} />
</div>

<style>
  .icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 15vw;
    height: 15vw;
    max-width: 150px;
    max-height: 150px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #FFFFFF;
    margin: 0 auto;
    background: #222;
  }

  @media (max-width: 768px) {
    .icon {
      width: 100px;
      height: 100px;
    }
  }

  .icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>