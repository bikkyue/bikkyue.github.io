---
  // コンポーネントのインポート
import ProfileIcon from "../components/ProfileIcon.astro";
import LinkList from "../components/LinkList.astro";
import SocialLinks from "../components/SocialLinks.astro";
import GalleryClient from "../components/GalleryClient.jsx";

  // .env から環境変数を取得
const apiUrl = import.meta.env.PUBLIC_MISSKEY_API_URL;
const siteTitle = import.meta.env.PUBLIC_SITE_TITLE;
const galleryTag = import.meta.env.PUBLIC_GALLERY_TAG;
const bgImage = import.meta.env.PUBLIC_BG_IMAGE;
const galleryLimit = parseInt(import.meta.env.PUBLIC_GALLERY_LIMIT);
const profileIcon = import.meta.env.PUBLIC_PROFILE_ICON;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href={profileIcon} />
    <meta name="viewport" content="width=device-width" />
    <title>{siteTitle}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Mono:wght@700&display=swap" rel="stylesheet">
<style>
  @font-face {
    font-family: Geist;
    src: url(/Geist.ttf);
    font-display: swap;
  }
</style>
  </head>
<body
  class="bg-[#1e1e1e] flex flex-col justify-center items-center w-screen min-h-screen font-[Geist] text-white"
  style={`background-image: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)), url('${bgImage}'); background-repeat: no-repeat; background-size: cover; background-position: center;`}
>
    <div class="w-[80%] mt-8 flex flex-col lg:flex-row gap-3">
      <main class="flex-1 flex flex-col gap-8 mt-12">
        {/* プロフィールアイコン表示 */}
        <ProfileIcon src={profileIcon} />
        <h1 class="md:text-6xl text-4xl font-black text-center">Bikyu</h1>
        <LinkList/>
        <SocialLinks />
      </main>
      {/* ギャラリー表示（クライアントサイドでfetch） */}
      <GalleryClient apiUrl={apiUrl} tag={galleryTag} limit={galleryLimit} client:load />
    </div>
  </body>
</html>