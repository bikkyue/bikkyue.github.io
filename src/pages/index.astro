---
  // コンポーネントのインポート
import ProfileIcon from "../components/ProfileIcon.astro";
import LinkList from "../components/LinkList.astro";
import SocialLinks from "../components/SocialLinks.astro";

// .env から環境変数を取得
const apiUrl = import.meta.env.PUBLIC_MISSKEY_API_URL;
const siteTitle = import.meta.env.PUBLIC_SITE_TITLE;
const siteDescription = import.meta.env.PUBLIC_SITE_DESCRIPTION;
const galleryTag = import.meta.env.PUBLIC_GALLERY_TAG;
const bgImage = import.meta.env.PUBLIC_BG_IMAGE;
const galleryLimit = parseInt(import.meta.env.PUBLIC_GALLERY_LIMIT);
const profileIcon = import.meta.env.PUBLIC_PROFILE_ICON;
const ogImage = import.meta.env.PUBLIC_OG_IMAGE;

const bgStyle = `
  body::before {
    background-image: linear-gradient(rgba(0,0,0,0.1), rgba(0,0,0,0.1)), url('${bgImage}');
  }
`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/x-icon" href={profileIcon} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={siteDescription} />
    <title>{siteTitle}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'M PLUS Rounded 1c', 'ヒラギノ角ゴ ProN', 'Hiragino Kaku Gothic ProN', 'メイリオ', Meiryo, sans-serif;
        font-weight: 700;
      }
      body::before {
        content: "";
        position: fixed;
        z-index: 0;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        pointer-events: none;
        filter: blur(8px);
        opacity: 1;
        transition: filter 1s ease, opacity 1s ease;
      }
      @media (max-width: 768px) {
        body::before {
          background-position: calc(30%) center;
        }
      }
      body.bg-fadein::before {
        filter: blur(0);
        opacity: 1;
      }
      body.blurred::before {
        /* filter: blur(4px); 削除 or コメントアウト */
      }
      body > * {
        position: relative;
        z-index: 1;
      }
      .content {
        opacity: 0;
        transition: opacity 0.7s;
      }
      body.show-content .content {
        opacity: 1;
        transition: opacity 0.7s;
      }
      .loader {
        position: fixed;
        z-index: 10000;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: rgba(20, 20, 20, 0.7);
        transition: opacity 0.5s;
      }
      .loader.hide {
        opacity: 0;
        pointer-events: none;
      }
      .spinner {
        border: 4px solid #fff3;
        border-top: 4px solid #fff;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin-bottom: 20px;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .loading-text {
        color: #fff;
        font-size: 1.3rem;
        letter-spacing: 0.1em;
        animation: blink 1.5s steps(2, start) infinite;
      }
      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.2;
        }
      }
      .icon-wrapper {
        text-align: center;
        padding: 3rem 2rem;
        border-radius: 0.5rem;
        background-color: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        display: block;
        max-width: 1400px;
        margin: 0 auto;
        min-height: 600px;
      }
    </style>
  </head>
  <body
    class="bg-[#1e1e1e] flex flex-col justify-center items-center w-screen min-h-screen text-white"
    style={`position: relative; font-family: 'M PLUS Rounded 1c', 'ヒラギノ角ゴ ProN', 'Hiragino Kaku Gothic ProN', 'メイリオ', Meiryo, sans-serif; font-weight: 700;`}
  >
    <style set:html={bgStyle}></style>

    <!-- ローディング演出 -->
    <div id="loader" class="loader">
      <div class="spinner"></div>
      <div class="loading-text">Loading...</div>
    </div>

    <div class="content">
      <div class="icon-wrapper">
        <div
          class="w-full max-w-screen-lg mt-8 flex flex-col lg:flex-row gap-3 mx-auto"
        >
          <main
            class="flex-1 flex flex-col gap-12 mt-20 mb-12 mx-auto w-full max-w-screen-md px-4"
          >
            <div class="flex justify-center items-center w-fit mx-auto">
              <ProfileIcon src={profileIcon} />
            </div>
<h1 class="text-5xl md:text-6xl font-black text-center">Bikyu</h1>
            <LinkList />
            <SocialLinks />
          </main>
        </div>
      </div>
    </div>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        setTimeout(() => {
          document.body.classList.add("bg-fadein");
        }, 1400);
        setTimeout(() => {
          document.body.classList.add("blurred");
        }, 1000);
        setTimeout(() => {
          document.body.classList.add("show-content");
          document.getElementById("loader").classList.add("hide");
        }, 1400);
      });
    </script>
  </body>
</html>