# アイコン
#PUBLIC_PROFILE_ICON=/icon/Profile2.png
PUBLIC_PROFILE_ICON=/icon/Profile3.png

# 背景画像のパスまたはURL
#PUBLIC_BG_IMAGE=/background/VRChat_2025-01-26_22-36-06.612_3840x2160.png
PUBLIC_BG_IMAGE=/background/20250624-VRChat_2025-06-24_22-21-37.551_7680x4320-2.jpg

# サムネイル画像
PUBLIC_OG_IMAGE=/icon/Profile2.png

#サイトの説明
PUBLIC_SITE_DESCRIPTION=びっきゅのページ

# サイトのタイトル
PUBLIC_SITE_TITLE=bikyu83.com

# Misskey API のURL（必ずPUBLIC_をつける）
PUBLIC_MISSKEY_API_URL=https://misskey-api-worker.misskey-proxy.workers.dev/images

# ギャラリー取得対象のハッシュタグ
PUBLIC_GALLERY_TAG=

# 画像の抽出数（数値も文字列でOK。parseIntで利用可）
PUBLIC_GALLERY_LIMIT=2