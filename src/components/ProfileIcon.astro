---
// props を使って画像のパスをカスタマイズ可能にします
const { src = "/icon/Profile.png", alt = "Profile Icon" } = Astro.props;
---

<div class="icon">
  <img src={src} alt={alt} class="mx-auto block max-w-full h-auto" />
</div>

<style>
  .icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 120px !important;
    height: 120px !important;
    max-width: none !important;
    max-height: none !important;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #FFFFFF;
    margin: 0 auto;
    background: #222;
  }

  .icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>