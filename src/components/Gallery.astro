---
type GalleryImage = {
  imageUrl: string;
  noteUrl: string;
};
const defaultTitle = import.meta.env.PUBLIC_GALLERY_TITLE ?? '';
const galleryTag = import.meta.env.PUBLIC_GALLERY_TAG ?? '';
const columnsClass = import.meta.env.PUBLIC_GALLERY_COLUMNS ?? 'columns-1 sm:columns-2 lg:columns2';
const { title = defaultTitle || `#${galleryTag}`, images = [] } = Astro.props as { title?: string; images: GalleryImage[] };
---
<section id="gallery" class="flex-1 px-6 py-10 bg-[#111a24] bg-opacity-30 backdrop-blur-md rounded-2xl shadow-2xl">
  <header class="mb-8 text-center">
    <h2 class="text-2xl sm:text-4xl font-bold break-words font-['Fira_Mono']">{title}</h2>
  </header>
  <div class={columnsClass + " gap-6"}>
    {images.map(({ imageUrl, noteUrl }) => (
      <a href={noteUrl} target="_blank" rel="noopener noreferrer">
        <div
          class="break-inside-avoid relative overflow-hidden p-2 border-2 border-white border-opacity-50 rounded-md shadow-lg group mb-6"
          style="clip-path: polygon(20px 0%, calc(100% - 20px) 0%, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 0% calc(100% - 20px), 0% 20px);"
        >
          <img
            src={imageUrl}
            alt="Misskey Image"
            class="w-full object-cover rounded-md transition-transform duration-300 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-black bg-opacity-40 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      </a>
    ))}
  </div>
</section>