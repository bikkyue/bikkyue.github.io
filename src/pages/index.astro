---
import Card from "../components/card.astro";
import Chip from "../components/chip.astro";


const links: Link[] = [
  {
    desc: "VRChat", // 表示されるテキスト
    link: "vrchat.com/home/user/usr_b2ab2e1c-7ef0-4ffb-ab58-e2645d62bc9c", // リンク先
    icon: "/icon/VRC.png", // アイコン画像のパス
  },
];

---

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/x-icon' href='/favicon.png' />
    <meta name='viewport' content='width=device-width' />
    <title>Background with Frames</title>
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css'
      integrity='sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=='
      crossorigin='anonymous'
      referrerpolicy='no-referrer'
    />
    <meta name='generator' content={Astro.generator} />
    <meta name='description' content='Useful links of Neville Brem' />
    <meta name='author' content='Neville Brem' />
    <meta property='og:title' content='Neville Brem' />
    <meta property='og:image' content='favicon.png' />
    <meta property='og:description' content='Linktree of Neville Brem' />
    <meta property='twitter:description' content='Linktree of Neville Brem' />
    <meta property='twitter:title' content='Neville Brem' />
    <meta property='twitter:image' content='favicon.png' />
    <meta name='twitter:card' content='summary' />
    <meta name='twitter:site' content='@BremNeville' />
    <title>Links of Neville Brem</title>
    <style>
      @font-face {
        font-family: Geist;
        src: url(/Geist.ttf);
        font-display: swap;
      }
/* 既存の背景スタイル */
    body { 
      background-image: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)), 
        url('/background/VRChat_2025-01-26_22-36-06.612_3840x2160.png');
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center;
      height: 100vh;
      margin: 0;
      font-family: Arial, sans-serif;
      color: white;
      text-align: center;
    }
    .icon {
    display: flex;
    justify-content: center;
    width: 15vw; /* ビューポートの幅に対する割合 */
    height: 15vw;
    max-width: 150px; /* 最大サイズ制限 */
    max-height: 150px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #FFFFFF;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .icon {
      width: 100px; /* スマホ向けに小さく */
      height: 100px;
    }
}
    </style>
  </head>
  <body
    class='bg-[#1e1e1e] flex justify-center items-center w-screen h-screen font-[Geist] text-white'
  >

    <main class='w-[80%] flex flex-col gap-8'>

      <div class='icon grid justify-center gap-4'>
        <img src='/icon/Profile.png'>
      </div>
      <h1 class='md:text-6xl text-4xl font-black text-center'>Bikyu</h1>
      <div class='grid justify-center gap-4'>
        {
          links.map(({ desc, link, icon }) => {
            return <Card {desc} {link} {icon} />;
          })
        }
      </div>
      <div class='flex justify-center gap-8'>
        <!-- Put some social links who have a definitive icon here: -->
        <Chip link='youtube.com/@bikyu42' icon='fa-brands fa-youtube' />
        <Chip link='x.com/Alche_bky' icon='fa-brands fa-x-twitter' />
      </div>
      <!--p class='text-center mx-auto'>Some additional text, like your email</p-->
    </main>
  </body>
</html>
